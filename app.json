{
  "expo": {
    "name": "Inventory App",
    "slug": "inventory-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "com.yourcompany.inventoryapp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.inventoryapp"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan item barcodes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3cd57cab-96e7-4556-b231-00f0d9bca2fb"
      }
    }
  }
}
