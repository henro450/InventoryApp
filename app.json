{
  "expo": {
    "name": "HenroTech",
    "slug": "inventory-app",
    "owner": "henro450",
    "version": "1.0.0",
    "scheme": "beams",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E1322"
    },
    "android": {
      "package": "com.yourcompany.inventoryapp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F3FD1"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.inventoryapp"
    },
    "plugins": [
      "./plugins/withBundledSQLite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan item barcodes."
        }
      ],
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID to log you in."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow $(PRODUCT_NAME) to open your contacts so you can pick the customer who is paying part of a sale."
        }
      ],
      [
        "expo-notifications",
        {}
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to photograph receipts for proof of payment.",
          "photosPermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3cd57cab-96e7-4556-b231-00f0d9bca2fb"
      }
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
