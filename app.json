{
  "expo": {
    "name": "Inventory App",
    "slug": "inventory-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.yourcompany.inventoryapp"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.inventoryapp"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan item barcodes."
        }
      ]
    ]
  }
}
